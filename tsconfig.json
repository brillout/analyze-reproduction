{
  "compilerOptions": {
    "outDir": "./dist/",
    "rootDir": "./src/",
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/**/*"
  ]
}
